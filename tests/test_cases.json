{
  "_comment": "SIL Test Suite — Motor Speed Controller v1.0",
  "_comment2": "Each test case ID maps to a system requirement (REQ-CTRL-xxx)",

  "test_suite": "Motor Speed Controller — SIL v1.0",

  "dt": 0.01,

  "pid_gains": {
    "kp": 3.0,
    "ki": 2.5,
    "kd": 0.05
  },

  "plant": {
    "max_speed": 100.0,
    "time_constant": 0.5,
    "friction": 0.02,
    "noise_std": 0.0
