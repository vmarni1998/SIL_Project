      "tolerance": 0.5,
      "check_overshoot": false,
      "max_overshoot_pct": 0.0
    },
    {
      "id": "TC_005",
      "requirement": "REQ-CTRL-005",
      "description": "Speed step-down — reduce from 80% to 30%",
      "setpoint": 30.0,
      "initial_speed": 80.0,
      "duration_s": 5.0,
      "tolerance": 2.5,
      "check_overshoot": false,
      "max_overshoot_pct": 0.0
    },
    {
      "id": "TC_006",
      "requirement": "REQ-CTRL-006",
      "description": "75% speed hold — upper-mid range steady state",
      "setpoint": 75.0,
      "initial_speed": 0.0,
      "duration_s": 5.0,
      "tolerance": 2.5,
      "check_overshoot": true,
      "max_overshoot_pct": 12.0
