      "requirement": "REQ-CTRL-001",
      "description": "Step from 0 to 50% speed — mid-range setpoint tracking",
      "setpoint": 50.0,
      "initial_speed": 0.0,
      "duration_s": 4.0,
      "tolerance": 2.0,
      "check_overshoot": true,
      "max_overshoot_pct": 15.0
    },
    {
      "id": "TC_002",
      "requirement": "REQ-CTRL-002",
      "description": "Full speed command — maximum setpoint reach",
      "setpoint": 100.0,
      "initial_speed": 0.0,
      "duration_s": 5.0,
      "tolerance": 3.0,
      "check_overshoot": false,
      "max_overshoot_pct": 0.0
    },
    {
      "id": "TC_003",
      "requirement": "REQ-CTRL-003",
      "description": "Low-speed precision hold — minimum setpoint stability",
      "setpoint": 10.0,
      "initial_speed": 0.0,
      "duration_s": 6.0,
      "tolerance": 1.0,
      "check_overshoot": true,
      "max_overshoot_pct": 25.0
    },
    {
      "id": "TC_004",
      "requirement": "REQ-CTRL-004",
